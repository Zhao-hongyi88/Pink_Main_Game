[resource]
script = ExtResource("1_observation_data")
observation_id = &"rental_contract"
title = "租房单"
info = "当前租房：\n月租：4,200\n押金：8,400\n水电 / 网络：620\n距公司：7.8 km\n租期：12 个月\n\n此前看过的房源：\n房源 A\n2,800 / 月\n通勤：1 小时 26 分钟\n\n房源 B\n3,300 / 月\n通勤：58 分钟\n\n房源 C\n4,200 / 月\n通勤：24 分钟"
images = []
image_placeholders = []
dialogue = PackedStringArray("这套房的租金不低啊……但离公司很近。", "附近还有更便宜的房源，只是通勤时间会明显增加。", "……省下来的时间，最后也没有得到充足的休息时间。")
