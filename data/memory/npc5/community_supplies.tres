[gd_resource type="Resource" script_class="MemoryObservationData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/memory/memory_observation_data.gd" id="1_observation_data"]

[resource]
script = ExtResource("1_observation_data")
observation_id = &"community_supplies"
title = "社区物资"
info = "社区援助物资：\n- 矿泉水\n- 药品\n- 棉被\n- 食品\n\n纸箱上保留不同捐赠人的姓名和日期。\n\n张某\n2025.03.12\n\n李某\n2025.04.05\n\n王某\n2025.05.18\n\n来自不同人的长期捐赠记录。"
images = []
image_placeholders = []
dialogue = PackedStringArray("这些物资来自不同的人。", "有些名字还重复出现了很多次。", "看来这里一直有人在提供帮助。")
