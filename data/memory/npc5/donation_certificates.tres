[gd_resource type="Resource" script_class="MemoryObservationData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/memory/memory_observation_data.gd" id="1_observation_data"]

[resource]
script = ExtResource("1_observation_data")
observation_id = &"donation_certificates"
title = "爱心捐款证书"
info = "不同年份的公益捐赠证书。\n\n特点：\n- 多年份\n- 长期捐赠\n- 小额持续"
images = []
image_placeholders = PackedStringArray("公益捐赠证书1", "公益捐赠证书2", "公益捐赠证书3")
dialogue = PackedStringArray("不止是在社区帮忙，他自己也一直在捐款。", "这些证书的日期隔了好几年，看来不是临时起意。", "金额算不上多，但一直没有中断。")
