[gd_resource type="Resource" script_class="MemoryObservationData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/memory/memory_observation_data.gd" id="1_observation_data"]

[resource]
script = ExtResource("1_observation_data")
observation_id = &"medical_record"
title = "医生电脑上的病历"
info = "当前状态：病情持续时间较长\n治疗建议：长期治疗\n后续安排：定期复查 / 住院观察\n治疗周期：需持续跟进"
images = []
image_placeholders = []
dialogue = PackedStringArray("病情已经持续很长时间，而且需要长期治疗。", "按照记录，她之后还要定期复查、住院。", "也就是说，即使这次治疗结束，她也很难真正离开医院。")
