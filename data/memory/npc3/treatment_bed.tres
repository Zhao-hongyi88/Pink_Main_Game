[gd_resource type="Resource" script_class="MemoryObservationData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/memory/memory_observation_data.gd" id="1_observation_data"]

[resource]
script = ExtResource("1_observation_data")
observation_id = &"treatment_bed"
title = "病床上的治疗"
info = "当前状态：正在接受治疗\n治疗时长：已持续数小时\n后续安排：仍需重复进行\n行动状态：需留在病床上等待治疗结束"
images = []
image_placeholders = []
dialogue = PackedStringArray("治疗已经进行了几个小时。", "从记录来看，这样的过程之后还会重复很多次。", "她现在没有工作，也没有做其他事情，只是在这里等待治疗结束。", "……为了延长以后的时间，她正在不断花掉现在的时间。")
