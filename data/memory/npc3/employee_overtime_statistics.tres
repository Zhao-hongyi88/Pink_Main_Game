[resource]
script = ExtResource("1_observation_data")
observation_id = &"employee_overtime_statistics"
title = "Business Operation Report"
info_panel_background = ExtResource("2_panel_background")
info_icon = ExtResource("3_statistics_icon")
open_with_icon_preview = true
info = ""
info_page_titles = PackedStringArray("Strategic Transition Summary  1 / 5", "Strategic Options  2 / 5", "Strategic Options  3 / 5", "Expected Result  4 / 5", "Management Statement  5 / 5")
info_pages = PackedStringArray("Business Operation Report\n\nStrategic Transition Summary\nCompany: TimeLife Manufacturing Co.\nReport Period: Q2 224\n\nCurrent Business Status\nThe company is currently undergoing operational transition due to changes in market demand and production requirements.\nCurrent production capacity is insufficient to support planned business growth.", "Strategic Options\n\nOption 1: Maintain Current Capacity\nContinue operating with existing resources.\n\nExpected Result:\n• Reduced production output\n• Workforce adjustment required\n• Increased operational pressure", "Option 2: Expand Production Capacity\nIncrease production capability through external time financing.\n\nRequired Measures:\n• Apply for corporate time loan\n• Increase available production hours\n• Extend employee working schedules during expansion period", "Expected Result:\n• Maintain workforce stability\n• Support business growth\n• Increase long-term production capacity", "Management Statement\nThe company must make a strategic decision between short-term stability and long-term expansion.\n\nAdditional time resources are required to achieve production growth targets.")
images = Array[Texture2D]([])
image_placeholders = PackedStringArray()
dialogue = PackedStringArray("The report shows that the company is facing operational pressure.", "Workforce adjustments were not a sudden decision, but the result of changes across multiple indicators.", "Within this system, managers also need to take responsibility for the company's future.")
