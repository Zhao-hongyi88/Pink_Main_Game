[resource]
script = ExtResource("1_observation_data")
observation_id = &"daughter_chat_record"
title = "与女儿的聊天记录"
info = "近期家庭聊天记录\n\n包含：\n工作时间冲突\n晚归沟通\n孩子询问"
images = []
image_placeholders = []
dialogue = PackedStringArray("女儿：\n妈妈，今天回来吃饭吗？\n\nLisa：\n应该可以，等妈妈开完会。", "21:34\n\n女儿：\n妈妈你还回来吗？", "23:08\n\nLisa：\n宝贝睡了吗？", "看来她工作真的很忙，这样的对话已经不止一次了。")
