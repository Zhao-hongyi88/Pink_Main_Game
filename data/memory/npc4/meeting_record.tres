[gd_resource type="Resource" script_class="MemoryObservationData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/memory/memory_observation_data.gd" id="1_observation_data"]

[resource]
script = ExtResource("1_observation_data")
observation_id = &"meeting_record"
title = "公司领导的会议记录"
info = "会议类型：部门会议 / 高层汇报会议\n\n记录内容：\n近期会议安排密集，\n包含多个部门协调事项，\n并存在向更高层汇报记录。"
images = []
image_placeholders = []
dialogue = PackedStringArray("会议安排得很密，很多甚至直接连在一起。", "除了部门会议，她还需要频繁向更高层汇报。", "看来职位越高，需要负责和协调的事情也越多。")
