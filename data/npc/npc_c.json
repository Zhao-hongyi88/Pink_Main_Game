		},
		{
			"speaker_name": "Mary",
      "text": "Hello. I'd like to apply for a life-extension time loan.",
			"unlock_key": ""
		},
		{
			"speaker_name": "Me",
			"speaker_role": "player",
      "text": "Of course.\nWill the loan be for your own use?",
			"unlock_key": ""
		},
		{
			"speaker_name": "Mary",
      "text": "Yes.",
			"unlock_key": ""
		},
		{
			"speaker_name": "Me",
			"speaker_role": "player",
      "text": "All right. How much time credit would you like to apply for?",
			"unlock_key": ""
		},
		{
			"speaker_name": "Mary",
      "text": "One year, I think.",
			"unlock_key": ""
		},
		{
			"speaker_name": "Me",
			"speaker_role": "player",
      "text": "All right, but I need to remind you: under the regulations, if you cannot repay the loan on your own in the future, your family may be required to share the obligation.",
			"unlock_key": ""
		},
		{
			"speaker_name": "Mary",
      "text": "...",
			"unlock_key": ""
		},
		{
			"speaker_name": "Mary",
      "text": "Then make it six months.",
			"unlock_key": ""
		},
		{
			"speaker_name": "Me",
			"speaker_role": "player",
      "text": "Are you sure you want to reduce the amount?",
			"unlock_key": ""
		},
		{
			"speaker_name": "Mary",
      "text": "Yes. Six months should be enough for now.",
			"unlock_key": ""
		},
		{
			"speaker_name": "Me",
			"speaker_role": "player",
      "text": "Your loan application has been submitted. Please hand over your application documents.\nPlease wait for the review result.",
			"unlock_key": ""
