[sub_resource type="Shader" id="Shader_reveal"]
code = "shader_type canvas_item;\n\nuniform vec2 center = vec2(0.5, 0.5);\nuniform float radius : hint_range(0.0, 1.5) = 0.0;\nuniform float feather : hint_range(0.001, 0.2) = 0.035;\n\nvoid fragment() {\n\tvec2 delta = UV - center;\n\tdelta.x *= SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;\n\tfloat distance_from_center = length(delta);\n\tfloat mask_alpha = smoothstep(radius, radius + feather, distance_from_center);\n\tCOLOR = vec4(0.0, 0.0, 0.0, mask_alpha);\n}\n"

